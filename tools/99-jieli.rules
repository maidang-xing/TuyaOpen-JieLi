# JieLi Technology USB Bootloader & Runtime Devices
# Grants non-root read/write permission to JieLi USB Bootloader and Composite devices

ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="3654", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0666"
ACTION=="add|change", SUBSYSTEM=="usb", ATTRS{idVendor}=="3654", MODE="0666", GROUP="plugdev"
ACTION=="add|change", SUBSYSTEM=="usb", ATTRS{idVendor}=="4c4a", MODE="0666", GROUP="plugdev"
ACTION=="add|change", SUBSYSTEM=="scsi_generic", ATTRS{idVendor}=="4c4a", MODE="0666", GROUP="plugdev"
ACTION=="add|change", SUBSYSTEM=="scsi_generic", ATTRS{idVendor}=="3654", MODE="0666", GROUP="plugdev"
ACTION=="add|change", SUBSYSTEM=="block", ATTRS{idVendor}=="4c4a", ENV{UDISKS_IGNORE}="1", ENV{ID_STORAGE_IGNORE}="1"
